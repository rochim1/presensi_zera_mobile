diff --git a/tests/google_login.security.test.js b/tests/google_login.security.test.js
new file mode 100644
index 00000000..7398fd0e
--- /dev/null
+++ b/tests/google_login.security.test.js
@@ -0,0 +1,117 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { OAuth2Client } = require('google-auth-library');
+const { Mutation } = require('../graphql/users/user.resolvers');
+const UserModel = require('../graphql/users/user.model');
+const SettingModel = require('../graphql/setting/setting.model');
+
+const verifiedProfile = {
+  email: 'google-user@example.test', email_verified: true,
+  sub: 'test-google-subject-12345', name: 'Google User',
+};
+
+function setup(t, profile = verifiedProfile) {
+  const originalClientId = process.env.GOOGLE_CLIENT_ID;
+  process.env.GOOGLE_CLIENT_ID = 'test-server-client.apps.googleusercontent.com';
+  t.after(() => {
+    if (originalClientId === undefined) delete process.env.GOOGLE_CLIENT_ID;
+    else process.env.GOOGLE_CLIENT_ID = originalClientId;
+  });
+  t.mock.method(OAuth2Client.prototype, 'verifyIdToken', async options => {
+    assert.equal(options.audience, process.env.GOOGLE_CLIENT_ID);
+    return { getPayload: () => profile };
+  });
+}
+
+test('Google login rejects invalid tokens before accessing accounts', async t => {
+  setup(t);
+  t.mock.method(OAuth2Client.prototype, 'verifyIdToken', async () => { throw new Error('invalid'); });
+  const lookup = t.mock.method(UserModel, 'findOne', () => { throw new Error('must not query'); });
+  await assert.rejects(Mutation.Login(null, {
+    input: { provider: 'google', tokenId: 'invalid-token' },
+  }, { req: {}, res: {} }), /Verifikasi akun Google gagal/);
+  assert.equal(lookup.mock.callCount(), 0);
+});
+
+test('Google login rejects unverified email', async t => {
+  setup(t, { ...verifiedProfile, email_verified: false });
+  await assert.rejects(Mutation.Login(null, {
+    input: { provider: 'google', tokenId: 'test-token' },
+  }, { req: {}, res: {} }), /email terverifikasi/);
+});
+
+test('new Google account requests registration details instead of silently creating a user', async t => {
+  setup(t);
+  t.mock.method(UserModel, 'findOne', async () => null);
+  await assert.rejects(Mutation.Login(null, {
+    input: { provider: 'google', tokenId: 'test-token' },
+  }, { req: {}, res: {} }), error => error.extensions.code === 'GOOGLE_REGISTRATION_DETAILS_REQUIRED');
+});
+
+test('Google login still enforces one user one device', async t => {
+  setup(t);
+  t.mock.method(UserModel, 'findOne', async () => ({
+    _id: '507f1f77bcf86cd799439011', confirm_email: true,
+    mac_address: 'registered-device', instansi_id: 'tenant',
+  }));
+  t.mock.method(SettingModel, 'findOne', async () => ({ one_user_one_device: true }));
+  await assert.rejects(Mutation.Login(null, {
+    input: { provider: 'google', tokenId: 'test-token', mac_address: 'another-device' },
+  }, { req: {}, res: {} }), /Perangkat tidak terdaftar/);
+});
+
+test('Google registration proceeds into public registration validation with request context', async t => {
+  setup(t);
+  let lookups = 0;
+  t.mock.method(UserModel, 'findOne', () => {
+    lookups++;
+    if (lookups === 1) return null;
+    return { select: () => ({ lean: async () => lookups === 2 ? null : { email: verifiedProfile.email } }) };
+  });
+  t.mock.method(UserModel, 'exists', async () => false);
+  // A duplicate discovered inside CreateUser stops before any database writes.
+  // Previously this path threw ReferenceError because Login had no ctx binding.
+  await assert.rejects(Mutation.Login(null, {
+    input: {
+      provider: 'google', tokenId: 'test-token', telp_number: '081234567890',
+      legal_consent: true, primary_product: 'hrms', registration_source: 'mobile_zera',
+    },
+  }, { req: {}, res: {} }), /Email sudah digunakan/);
+  assert.equal(lookups, 3);
+});
+
+test('new Google registration records consent and verified email before saving', async t => {
+  setup(t);
+  let lookups = 0;
+  let captured;
+  t.mock.method(UserModel, 'findOne', () => {
+    if (++lookups === 1) return null;
+    return { select: () => ({ lean: async () => null }) };
+  });
+  t.mock.method(UserModel, 'exists', async () => false);
+  for (const modelPath of [
+    '../graphql/jabatan/jabatan.model',
+    '../graphql/divisi/divisi.model',
+    '../graphql/tipe_pegawai/tipe_pegawai.model',
+  ]) {
+    t.mock.method(require(modelPath), 'findById', () => ({ select: async () => null }));
+  }
+  t.mock.method(UserModel.prototype, 'save', async function () {
+    captured = this.toObject();
+    throw new Error('stop before database write');
+  });
+  await assert.rejects(Mutation.Login(null, {
+    input: {
+      provider: 'google', tokenId: 'test-token', telp_number: '081234567890',
+      legal_consent: true, primary_product: 'hrms', registration_source: 'mobile_zera',
+    },
+  }, { req: {}, res: {} }), /stop before database write/);
+  assert.equal(captured.confirm_email, true);
+  assert.equal(captured.provider, 'google');
+  assert.equal(captured.email, verifiedProfile.email);
+  assert.ok(captured.legal_accepted_at instanceof Date);
+  assert.equal(captured.primary_product, 'hrms');
+  assert.equal(captured.registration_source, 'mobile_zera');
+  assert.equal(captured.instansi_id, null);
+  assert.equal(captured.is_admin, false);
+});
diff --git a/tests/google_auth_public_fields.test.js b/tests/google_auth_public_fields.test.js
new file mode 100644
index 00000000..0c7b542d
--- /dev/null
+++ b/tests/google_auth_public_fields.test.js
@@ -0,0 +1,23 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const auth = require('../middlewares/authMiddleware');
+const { isFieldAllowed } = require('../middlewares/allowedFields');
+
+for (const [operation, field] of [
+  ['Query', 'GetGoogleRegistrationClientId'],
+  ['Mutation', 'RegisterUserWithGoogle'],
+]) {
+  test(`${field} works without a valid Pantoo session`, async () => {
+    assert.equal(isFieldAllowed(field), true);
+    const ctx = { token: 'Bearer stale-session', req: { headers: {} } };
+    let resolved = false;
+    await auth[operation][field](async () => { resolved = true; }, null, {}, ctx, { fieldName: field });
+    assert.equal(resolved, true);
+    assert.equal(ctx.token, null);
+  });
+}
+
+test('Google public endpoints do not expose private account mutations', () => {
+  assert.equal(isFieldAllowed('DeleteUser'), false);
+  assert.equal(isFieldAllowed('UpdateProfile'), false);
+});
diff --git a/scripts/verify-google-auth-production.cjs b/scripts/verify-google-auth-production.cjs
new file mode 100644
index 00000000..a1437db0
--- /dev/null
+++ b/scripts/verify-google-auth-production.cjs
@@ -0,0 +1,20 @@
+const assert = require('node:assert/strict');
+const expected = require('../ecosystem.config').apps[0].env_production.GOOGLE_CLIENT_ID;
+
+(async () => {
+  const endpoint = process.argv[2] || 'https://graphql.pantoo.id/';
+  const response = await fetch(endpoint, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ query: 'query { GetGoogleRegistrationClientId }' }),
+    signal: AbortSignal.timeout(20000),
+  });
+  const payload = await response.json();
+  assert.ok(response.ok && !payload.errors, 'Query konfigurasi Google belum tersedia di endpoint ini.');
+  assert.equal(payload.data?.GetGoogleRegistrationClientId, expected, 'Client ID server belum cocok dengan OAuth baru.');
+  console.log('PASS: endpoint publik Google dan client ID backend sudah sesuai.');
+  console.log('Lanjutkan uji login menggunakan akun Google milik Anda di aplikasi.');
+})().catch(error => {
+  console.error('FAIL:', error.message);
+  process.exitCode = 1;
+});
